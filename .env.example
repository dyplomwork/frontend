# VITE_API_CASES_URL=https://cases.example.com
# VITE_API_PLINKO_URL=https://plinko.example.com
# VITE_API_ROULETTE_URL=https://roulette.example.com
# VITE_API_TICKETS_URL=https://tickets.example.com
# VITE_API_ADMIN_URL=https://admin.example.com
